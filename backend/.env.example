# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# A local secret is generated in instance/ when empty. Never commit it.
SECRET_KEY=
DATABASE_URL=sqlite:///learnhub.db
COOKIE_SECURE=false
# Server-side only; do not use a VITE_ variable for credentials.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=45
